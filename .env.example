# Created locally by: docker compose --profile setup run --rm setup
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PHONE_NUMBER=
ADMIN_USER_IDS=

# Shared proxy (leave PROXY_TYPE empty to connect directly)
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Application
DATABASE_URL=postgresql+asyncpg://monitor:monitor@postgres:5432/monitor
DEFAULT_INTERVAL_SECONDS=60
CHECK_POLL_SECONDS=3
CHECK_CONCURRENCY=1
NOTIFICATION_ENABLED=true
LOG_LEVEL=INFO
